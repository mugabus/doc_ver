import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';

export const CONGO_TEMPLATE_URL = '/templates/congo-cirgl-template.pdf';
export const CONGO_ORIGIN_VALUE = 'R\u00c9PUBLIQUE D\u00c9MOCRATIQUE DU CONGO';

export interface CongoCertificateDetails {
  certificate_number: string;
  loading_number: string;
  province: string;
  exporter_name: string;
  exporter_address: string;
  importer_name: string;
  importer_address: string;
  export_license: string;
  shipment_date: string;
  expiration_date: string;
  quantity: string;
  minerals: string;
  chemical_symbol: string;
  net_weight_kg: string;
  content_percent: string;
  metal_contained: string;
  value_usd: string;
  containers: string;
  packing_type: string;
  transiting: string;
  carrier_name: string;
  issued_in: string;
}

export function isCongoCertificate(originCountry: string): boolean {
  return originCountry === CONGO_ORIGIN_VALUE;
}

function clean(v: unknown): string {
  return String(v ?? '').replace(/\s+/g, ' ').trim();
}

function formatSampleDate(value: string): string {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(clean(value));
  if (m) return m[3] + '/' + m[2] + '/' + m[1];
  return clean(value);
}

export async function buildFilledCongoCertificatePdf(
  details: CongoCertificateDetails,
  qrCodeDataUrl: string,
): Promise<Uint8Array> {
  const res = await fetch(CONGO_TEMPLATE_URL);
  if (!res.ok) throw new Error('Could not load template (' + res.status + ').');
  const pdf = await PDFDocument.load(await res.arrayBuffer(), { ignoreEncryption: true });
  const page = pdf.getPages()[0];
  const form = pdf.getForm();

  // Fill the template's OWN AcroForm fields natively via pdf-lib.
  // Placement comes from the PDF's widget rects, so every value lands
  // exactly in its own box — no manual coordinates needed.
  const set = (name: string, value: string) => {
    const text = clean(value);
    if (!text) return;
    try {
      form.getTextField(name).setText(text);
    } catch {
      /* field missing in this template revision — skip */
    }
  };

  const expLine = [clean(details.exporter_name), clean(details.exporter_address)]
    .filter(Boolean).join(' - ');
  const impLine = [clean(details.importer_name), clean(details.importer_address)]
    .filter(Boolean).join(' - ');

  set('issued_in', details.issued_in);
  set('value_usd', details.value_usd);
  set('metal_contained', details.metal_contained);
  set('content_percent', details.content_percent);
  set('net_weight_kg', details.quantity || details.net_weight_kg);
  set('chemical_symbol', details.chemical_symbol);
  set('minerals', details.minerals);
  set('containers', details.containers);
  set('packing_type', details.packing_type);
  set('transiting', details.transiting);
  set('carrier_name', details.carrier_name);
  set('expiry_date', formatSampleDate(details.expiration_date));
  set('shipment_date', formatSampleDate(details.shipment_date));
  set('export_license_no', details.export_license);
  set('importer_name_address', impLine);
  set('exporter_name_address', expLine);
  set('origin', 'RDC');
  set('province', details.province);
  set('shipment_no', details.loading_number);
  set('product', details.minerals || details.quantity);

  // Certificate number: template has no slot, draw bold by margin number.
  const certNo = clean(details.certificate_number);
  if (certNo) {
    const { width: pw, height: ph } = page.getSize();
    const bold = await pdf.embedFont(StandardFonts.HelveticaBold);
    const px = Math.min(612 * (pw / 842), pw - bold.widthOfTextAtSize(certNo, 11) - 8);
    const py = Math.min(Math.max(ph - 556 * (ph / 595), 8), ph - 14);
    page.drawText(certNo, { x: px, y: py, size: 11, font: bold, color: rgb(0, 0, 0) });
  }

  // Verification QR stamp.
  const qrBytes = await fetch(qrCodeDataUrl).then((r) => r.arrayBuffer());
  const qr = await pdf.embedPng(qrBytes);
  const { width: qw, height: qh } = page.getSize();
  const qs = Math.min(90, qw * 0.11, qh * 0.16);
  page.drawImage(qr, { x: qw - qs - 18, y: qh * 0.52, width: qs, height: qs });

  try { form.flatten(); } catch { /* best effort */ }
  return pdf.save();
}
